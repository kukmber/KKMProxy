<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/componentTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="13.5sp"
            android:textStyle="bold"
            tools:text="Ядро ByeDPI" />

        <TextView
            android:id="@+id/componentDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="monospace"
            android:textColor="@color/muted"
            android:textSize="10.5sp"
            tools:text="hufrea/byedpi · встроено v17.3" />
    </LinearLayout>

    <TextView
        android:id="@+id/componentTag"
        style="@style/Dash.StatusTag"
        android:layout_marginStart="8dp"
        android:visibility="gone"
        tools:text="v0.17.4"
        tools:visibility="visible" />

    <ImageView
        style="@style/Dash.RowIcon"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="0dp"
        android:src="@drawable/ic_k_chevron" />
</LinearLayout>
