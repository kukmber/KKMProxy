<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="8dp"
    android:paddingEnd="18dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/dash_sheet_title"
        android:textColor="@color/text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/sheetImportUrl"
        style="@style/Dash.SheetItem">

        <ImageView
            style="@style/Dash.SheetIcon"
            android:src="@drawable/ic_k_link"
            app:tint="@color/accent" />

        <TextView
            style="@style/Dash.SheetText"
            android:text="@string/dash_sheet_url" />
    </LinearLayout>

    <View style="@style/Dash.Divider" />

    <LinearLayout
        android:id="@+id/sheetImportClipboard"
        style="@style/Dash.SheetItem">

        <ImageView
            style="@style/Dash.SheetIcon"
            android:src="@drawable/ic_k_paste"
            app:tint="@color/accent2" />

        <TextView
            style="@style/Dash.SheetText"
            android:text="@string/dash_sheet_clipboard" />
    </LinearLayout>

    <View style="@style/Dash.Divider" />

    <LinearLayout
        android:id="@+id/sheetImportQr"
        style="@style/Dash.SheetItem">

        <ImageView
            style="@style/Dash.SheetIcon"
            android:src="@drawable/ic_k_qr"
            app:tint="@color/warn" />

        <TextView
            style="@style/Dash.SheetText"
            android:text="@string/dash_sheet_qr" />
    </LinearLayout>

    <View style="@style/Dash.Divider" />

    <LinearLayout
        android:id="@+id/sheetImportFile"
        style="@style/Dash.SheetItem">

        <ImageView
            style="@style/Dash.SheetIcon"
            android:src="@drawable/ic_k_file"
            app:tint="@color/muted" />

        <TextView
            style="@style/Dash.SheetText"
            android:text="@string/dash_sheet_file" />
    </LinearLayout>
</LinearLayout>
